# ─── Database ────────────────────────────────────────────────────────────────
# Dev: point at your Ubuntu server's IP
# Prod: uses internal Docker network name (postgres)
DATABASE_URL=postgresql://xflasar:your-password@192.168.1.XXX:5432/portfolio

# ─── Auth (Keycloak) ─────────────────────────────────────────────────────────
# Dev: point at your Ubuntu server's IP
# Prod: uses internal Docker network name (keycloak)
KEYCLOAK_URL=http://192.168.1.XXX:8080
KEYCLOAK_REALM=xflasar

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

